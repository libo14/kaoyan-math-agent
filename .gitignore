# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets and local config
.env
.env.*
!.env.example
*.local

# Runtime caches and browser automation profiles
.chatgpt-chrome-profile/
__pycache__/
*.py[cod]
playwright-report/
test-results/
.cache/

# Data policy
data/raw/
data/chatgpt_outputs/

# Publish ChatGPT-generated Markdown imports, but keep images/PDFs local.
data/imports/*
!data/imports/
!data/imports/*/
!data/imports/**/*.md
!data/imports/**/*.json
data/imports/**/*.png
data/imports/**/*.jpg
data/imports/**/*.jpeg
data/imports/**/*.pdf
data/imports/**/pdf_pages/
data/imports/**/extracted/

# Publish text knowledge-base outputs, but keep binary caches local.
data/processed/*
!data/processed/
!data/processed/README.md
!data/processed/question_bank.jsonl
!data/processed/rag_chunks.jsonl
!data/processed/review_report.md
data/processed/*.sqlite

# Keep the tiny synthetic/demo dataset for open-source demos
!data/processed-demo/
!data/processed-demo/**
!data/raw-demo/
!data/raw-demo/**
data/raw-demo/**/gemini.md
data/processed-demo/*.sqlite

# OS / editor files
.DS_Store
Thumbs.db
.idea/
.vscode/

# Build outputs
dist/
out/
release/
